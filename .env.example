# ==============================================================================
# Gemini Token Counter - Optional Environment Configuration
# ==============================================================================
# All settings and directories are automatically discovered dynamically by default.
# Use these variables ONLY if you need custom directory overrides or non-standard paths.

# Custom Antigravity storage directory (default: auto-discovered across profiles, drives & WSL2)
# ANTIGRAVITY_DIR="C:\Users\username\.gemini"

# Custom Brain sessions directory override
# GEMINI_BRAIN_DIR="C:\Users\username\.gemini\antigravity\brain"

# Custom refresh polling interval in seconds (default: 3)
# GEMINI_REFRESH_INTERVAL=3
